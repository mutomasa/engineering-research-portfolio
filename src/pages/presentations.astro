---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';
import { getDecks } from '../lib/speakerdeck';
import { formatDate } from '../lib/blog';

const result = await getDecks();
const decks = result.ok ? result.decks : [];
---

<Layout title="Presentations" description="Slides and talks published on Speaker Deck.">
	<div class="page">
		<h1 class="page-title">Presentations</h1>
		<p class="lead">
			発表スライド・資料を <a href={SITE.speakerdeck.url} rel="noopener noreferrer">Speaker Deck</a>
			で公開しています。公開日の新しい順に表示しています。
		</p>

		{
			!result.ok || decks.length === 0 ? (
				<div class="notice" role="alert">
					<p>
						<strong>
							{result.ok
								? '公開中のスライドが見つかりませんでした。'
								: 'スライド一覧を取得できませんでした。'}
						</strong>
					</p>
					{!result.ok && <p>({result.error})</p>}
					<p>
						<a class="text-link" href={SITE.speakerdeck.url} rel="noopener noreferrer">
							<Icon name="slides" size={18} /> Speaker Deck のプロフィールを開く
						</a>
					</p>
				</div>
			) : (
				<>
					<p class="result-count">{decks.length} presentations</p>

					<ul class="card-grid">
						{decks.map((deck) => (
							<li>
								<a class="card deck" href={deck.url} target="_blank" rel="noopener noreferrer">
									{deck.thumbnail && (
										<img
											class="deck-thumb"
											src={deck.thumbnail}
											alt=""
											loading="lazy"
											decoding="async"
											referrerpolicy="no-referrer"
										/>
									)}
									<h2>{deck.title}</h2>
									{deck.description && <p class="deck-desc">{deck.description}</p>}
									<div class="meta">
										<span>
											<time datetime={deck.publishedAt}>{formatDate(deck.publishedAt)}</time>
										</span>
									</div>
									<span class="card-cta">
										View on Speaker Deck <Icon name="external" size={16} />
										<span class="visually-hidden">(opens in a new tab)</span>
									</span>
								</a>
							</li>
						))}
					</ul>

					<p class="result-count" style="margin-top:1.5rem">
						Fetched from the Speaker Deck feed on <time datetime={result.fetchedAt}
							>{formatDate(result.fetchedAt)}</time
						>.
					</p>
				</>
			)
		}
	</div>
</Layout>
