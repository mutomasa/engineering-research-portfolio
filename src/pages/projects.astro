---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
import { SITE } from '../consts';
import { getPublicRepos } from '../lib/github';
import { formatDate } from '../lib/blog';
import { PROJECT_NOTES, PROJECT_CATEGORIES } from '../data/projectNotes';

const result = await getPublicRepos();
const repos = result.ok ? result.repos : [];
const noteOf = (name: string) => PROJECT_NOTES[name];
---

<Layout title="Projects" titleJa="プロジェクト" description={`Public repositories by ${SITE.github.user} on GitHub.`}>
	<div class="page">
		<h1 class="page-title"><T en="Projects" ja="プロジェクト" /></h1>
		<p class="lead">
			<T>
				<Fragment slot="en">
					Public GitHub repositories (<a href={SITE.github.url} target="_blank" rel="noopener noreferrer"
						>@{SITE.github.user}</a
					>), most recently updated first.
				</Fragment>
				<Fragment slot="ja">
					GitHub の公開リポジトリ（<a href={SITE.github.url} target="_blank" rel="noopener noreferrer"
						>@{SITE.github.user}</a
					>）を、更新日時の新しい順に表示しています。
				</Fragment>
			</T>
		</p>
		<p class="lead">
			<T
				en="Most projects are machine-learning work: computer vision, LLMs and AI agents, graphs and knowledge graphs, and robotics and spatial AI. Each summary below was written from the repository’s README or design documents."
				ja="機械学習のプロジェクトが中心で、コンピュータビジョン、LLM・AI Agent、グラフ・知識グラフ、ロボティクス・空間AI を扱っています。各カードの概要は、リポジトリの README や設計書をもとに書いています。"
			/>
		</p>

		{
			!result.ok || repos.length === 0 ? (
				<div class="notice" role="alert">
					<p>
						<strong>
							{result.ok ? (
									<T en="No public repositories found." ja="公開リポジトリが見つかりませんでした。" />
								) : (
									<T en="Could not fetch the repository list." ja="リポジトリ一覧を取得できませんでした。" />
								)}
						</strong>
					</p>
					{!result.ok && <p>({result.error})</p>}
					<p>
						<a class="text-link" href={SITE.github.reposUrl} target="_blank" rel="noopener noreferrer">
							<Icon name="github" size={18} />
							<T en="Open the repository list on GitHub" ja="GitHub のリポジトリ一覧を開く" />
						</a>
					</p>
				</div>
			) : (
				<>
					{/* JS が無効な環境では検索欄を出さず、一覧のみ表示する */}
					<form class="search" role="search" id="repo-search-form" hidden>
						<div class="search-field">
							<label class="visually-hidden" for="repo-search">
								<T
									en="Search repositories by name, description or language"
									ja="名前・説明・言語でリポジトリを検索"
								/>
							</label>
							<Icon name="search" size={18} />
							<input
								id="repo-search"
								type="search"
								placeholder="Search repositories"
								data-i18n-attr="placeholder"
								data-en="Search repositories"
								data-ja="リポジトリを検索"
								autocomplete="off"
							/>
						</div>
					</form>

					<p class="result-count" id="repo-count" aria-live="polite">
						<T en={`${repos.length} repositories`} ja={`${repos.length} 件のリポジトリ`} />
					</p>

					<ul class="card-grid" id="repo-list">
						{repos.map((repo) => (
							<li
								data-search={[
									repo.name,
									repo.description,
									repo.language,
									noteOf(repo.name)?.ja,
									noteOf(repo.name)?.en,
									noteOf(repo.name) && PROJECT_CATEGORIES[noteOf(repo.name)!.category].ja,
									noteOf(repo.name) && PROJECT_CATEGORIES[noteOf(repo.name)!.category].en,
								]
									.filter(Boolean)
									.join(' ')
									.toLowerCase()}
							>
								<article class="card repo">
									{noteOf(repo.name) && (
										<p class="repo-category">
											<T
												en={PROJECT_CATEGORIES[noteOf(repo.name)!.category].en}
												ja={PROJECT_CATEGORIES[noteOf(repo.name)!.category].ja}
											/>
										</p>
									)}
									<h2>
										<a href={repo.url} target="_blank" rel="noopener noreferrer">
											{repo.name}
										</a>
										{repo.fork && (
										<span class="badge">
											<T en="Fork" ja="フォーク" />
										</span>
									)}
										{noteOf(repo.name)?.status === 'design' && (
										<span class="badge">
											<T en="Design stage" ja="設計段階" />
										</span>
									)}
										{noteOf(repo.name)?.status === 'paused' && (
										<span class="badge">
											<T en="Paused" ja="開発中断" />
										</span>
									)}
										{repo.archived && (
										<span class="badge">
											<T en="Archived" ja="アーカイブ済み" />
										</span>
									)}
									</h2>
									{noteOf(repo.name) ? (
										<p>
											<T en={noteOf(repo.name)!.en} ja={noteOf(repo.name)!.ja} />
										</p>
									) : (
										<p>{repo.description ?? <T en="No description" ja="説明なし" />}</p>
									)}
									<div class="meta">
										{repo.language && <span>{repo.language}</span>}
										<span>
											<Icon name="star" size={14} />
											<span class="visually-hidden"><T en="Stars:" ja="スター数:" /></span>
											{repo.stars}
										</span>
										<span>
											<T en="Updated" ja="更新" /> <time datetime={repo.updatedAt}>{formatDate(repo.updatedAt)}</time>
										</span>
									</div>
								</article>
							</li>
						))}
					</ul>

					<p class="empty" id="repo-empty" hidden>
						<T en="No repositories match your search." ja="検索に一致するリポジトリはありません。" />
					</p>

					<p class="result-count" style="margin-top:1.5rem">
						<T>
							<Fragment slot="en">
								Fetched from the GitHub REST API on <time datetime={result.fetchedAt}
									>{formatDate(result.fetchedAt)}</time
								>.
							</Fragment>
							<Fragment slot="ja">
								<time datetime={result.fetchedAt}>{formatDate(result.fetchedAt)}</time> に GitHub REST API から取得しました。
							</Fragment>
						</T>
					</p>
				</>
			)
		}
	</div>
</Layout>

<script>
	import { getLang } from '../lib/i18n';

	const form = document.querySelector<HTMLFormElement>('#repo-search-form');
	const input = document.querySelector<HTMLInputElement>('#repo-search');
	const count = document.querySelector<HTMLElement>('#repo-count');
	const empty = document.querySelector<HTMLElement>('#repo-empty');
	const items = Array.from(
		document.querySelectorAll<HTMLLIElement>('#repo-list > li[data-search]'),
	);

	if (form && input && count && empty && items.length > 0) {
		form.hidden = false;
		form.addEventListener('submit', (event) => event.preventDefault());

		const apply = () => {
			// スペース区切りの語をすべて含むものを表示（AND 検索）
			const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
			let visible = 0;
			for (const item of items) {
				const haystack = item.dataset.search ?? '';
				const match = terms.every((term) => haystack.includes(term));
				item.hidden = !match;
				if (match) visible++;
			}
			const ja = getLang() === 'ja';
			count.textContent =
				terms.length === 0
					? ja
						? `${items.length} 件のリポジトリ`
						: `${items.length} repositories`
					: ja
						? `${items.length} 件中 ${visible} 件のリポジトリ`
						: `${visible} of ${items.length} repositories`;
			empty.hidden = visible > 0;
		};

		input.addEventListener('input', apply);
		document.addEventListener('langchange', apply);
	}
</script>

<style>
	.repo-category {
		margin: 0 0 0.35rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--muted);
	}
</style>
