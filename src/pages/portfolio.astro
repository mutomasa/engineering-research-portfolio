---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
import { formatDate } from '../lib/blog';

// 本文は src/content/portfolio/portfolio.md（freelance-portfolio/export_site.py で生成）
const doc = await getEntry('portfolio', 'portfolio');
if (!doc) throw new Error('src/content/portfolio/portfolio.md が見つかりません');
const { Content } = await render(doc);
---

<Layout title="Portfolio" titleJa={doc.data.title} description={doc.data.description}>
	<article class="page">
		<p class="eyebrow">
			<a class="text-link" href="/"><Icon name="back" size={16} /> <T en="Home" ja="ホーム" /></a>
		</p>
		<h1 class="page-title"><T en="Portfolio" ja={doc.data.title} /></h1>
		<p class="lead" lang="ja">{doc.data.description}</p>
		<div class="meta">
			<time datetime={doc.data.updated.toISOString()}>{formatDate(doc.data.updated)}</time>
			<a class="text-link" href="/portfolio/masahiro-muto-portfolio.pdf" target="_blank" rel="noopener">
				<T en="View PDF" ja="PDF を見る" />
			</a>
		</div>
		<p class="lead" data-lang-only="en" lang="en" style="margin-top:1.5rem">This page is available in Japanese only.</p>
		<div class="prose portfolio" style="margin-top:2rem" lang="ja">
			<Content />
		</div>
	</article>
</Layout>

<script>
	// ```mermaid のコードブロックを図に変換する
	const blocks = Array.from(document.querySelectorAll<HTMLElement>('pre:has(> code.language-mermaid)'));
	if (blocks.length > 0) {
		const { default: mermaid } = await import('mermaid');
		mermaid.initialize({ startOnLoad: false, theme: 'neutral', securityLevel: 'strict' });
		const nodes = blocks.map((pre) => {
			const div = document.createElement('div');
			div.className = 'mermaid';
			div.textContent = pre.textContent ?? '';
			pre.replaceWith(div);
			return div;
		});
		await mermaid.run({ nodes });
	}
</script>

<style>
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		align-items: center;
		color: var(--muted);
	}
	.portfolio :global(h2) {
		margin-top: 3rem;
		padding-bottom: 0.35rem;
		border-bottom: 2px solid var(--fg);
	}
	.portfolio :global(h3) {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}
	/* 一覧から飛んだときに見出しがヘッダーに隠れないようにする */
	.portfolio :global(a[id^='project-']) {
		display: block;
		scroll-margin-top: 5rem;
	}
	.portfolio :global(.meta) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0 0 0.75rem;
	}
	.portfolio :global(.tag),
	.portfolio :global(.status) {
		display: inline-block;
		padding: 0.05rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--muted);
		font-size: 0.8rem;
	}
	.portfolio :global(.status) {
		border-color: #d9a400;
		background: #fff6d6;
		color: #6b5200;
		font-weight: 600;
	}
	.portfolio :global(.mermaid) {
		margin: 0 0 1.5rem;
		overflow-x: auto;
		text-align: center;
	}
</style>
