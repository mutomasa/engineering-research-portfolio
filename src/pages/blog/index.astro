---
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';
import { pageHref } from '../../lib/url';
import T from '../../components/T.astro';

const posts = await getPublishedPosts();
---

<Layout
	title="Research Blog"
	titleJa="研究ブログ"
	description="Research notes, paper explainers and experiment results."
>
	<div class="page">
		<h1 class="page-title"><T en="Research Blog" ja="研究ブログ" /></h1>
		<p class="lead">
			<T
				en="Research notes, paper explainers and experiment results, newest first. Most posts are English translations of my Japanese blog; switch to 日本語 to read the originals."
				ja="研究日誌・論文解説・実験結果を、新しい順に掲載しています。日本語表示では、はてなブログの記事を翻訳せずに原文のまま読めます。"
			/>
		</p>

		{
			posts.length === 0 ? (
				<div class="empty">
					<p style="margin:0"><T en="No posts yet." ja="記事はまだありません。" /></p>
				</div>
			) : (
				<ul class="card-grid">
					{posts.map(({ slug, en, ja, pubDate, tags }) => (
						<li>
							<a class="card" href={pageHref(`/blog/${slug}`)}>
								<div class="meta">
									<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
									{!en && (
										<span class="badge" data-lang-only="en" lang="en">
											Japanese
										</span>
									)}
								</div>
								{en && ja ? (
									<>
										<h2 data-lang-only="en" lang="en">{en.data.title}</h2>
										<h2 data-lang-only="ja" lang="ja">{ja.data.title}</h2>
										<p data-lang-only="en" lang="en">{en.data.description}</p>
										<p data-lang-only="ja" lang="ja">{ja.data.description}</p>
									</>
								) : en ? (
									<>
										<h2>{en.data.title}</h2>
										<p>{en.data.description}</p>
									</>
								) : (
									ja && (
										<>
											<h2 lang="ja">{ja.data.title}</h2>
											<p lang="ja">{ja.data.description}</p>
										</>
									)
								)}
								{tags.length > 0 && (
									<ul class="tags" style="margin-top:auto;padding-top:0.5rem">
										{tags.map((tag) => (
											<li class="tag">{tag}</li>
										))}
									</ul>
								)}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</Layout>
