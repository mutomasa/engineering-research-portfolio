---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import T from '../../components/T.astro';
import { getPublishedPosts, formatDate, type Post } from '../../lib/blog';
import { pageHref } from '../../lib/url';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { en, ja, pubDate, tags } = post;
const EnContent = en ? (await render(en)).Content : undefined;
const JaContent = ja ? (await render(ja)).Content : undefined;
const github = en?.data.github;
const demo = en?.data.demo;
const originalUrl = ja?.data.originalUrl ?? en?.data.originalUrl;
// 英語・日本語の両方があるときだけ表示言語で切り替える。片方しかなければ常にそれを表示する。
const both = Boolean(en && ja);
const enAttrs = both ? { 'data-lang-only': 'en' } : {};
const jaAttrs = both ? { 'data-lang-only': 'ja' } : {};
---

<Layout
	title={(en ?? ja)!.data.title}
	titleJa={ja?.data.title}
	description={(en ?? ja)!.data.description}
>
	<article class="page">
		<p class="eyebrow">
			<a class="text-link" href={pageHref('/blog')}><Icon name="back" size={16} /> <T en="Research Blog" ja="研究ブログ" /></a
			>
		</p>
		{en && <h1 class="page-title" lang="en" {...enAttrs}>{en.data.title}</h1>}
		{ja && <h1 class="page-title" lang="ja" {...jaAttrs}>{ja.data.title}</h1>}
		<div class="meta">
			<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
		</div>
		{
			tags.length > 0 && (
				<ul class="tags" style="margin-top:0.75rem">
					{tags.map((tag) => (
						<li class="tag">{tag}</li>
					))}
				</ul>
			)
		}
		{
			(github || demo) && (
				<ul class="post-links">
					{github && (
						<li>
							<a class="text-link" href={github} target="_blank" rel="noopener noreferrer">
								<Icon name="github" size={18} /> <T en="Related GitHub" ja="関連 GitHub" />
							</a>
						</li>
					)}
					{demo && (
						<li>
							<a class="text-link" href={demo} target="_blank" rel="noopener noreferrer">
								<Icon name="play" size={18} /> <T en="Live demo" ja="ライブデモ" />
							</a>
						</li>
					)}
				</ul>
			)
		}
		{
			!en && (
				<p class="lead" data-lang-only="en" lang="en" style="margin-top:1.5rem">
					This post is available in Japanese only.
				</p>
			)
		}

		{
			EnContent && (
				<div class="prose" style="margin-top:2rem" lang="en" {...enAttrs}>
					<EnContent />
				</div>
			)
		}
		{
			JaContent && (
				<div class="prose" style="margin-top:2rem" lang="ja" {...jaAttrs}>
					<JaContent />
					<hr />
					<p>
						<em>
							この記事は、はてなブログに投稿した原文をそのまま掲載しています。元記事：
							<a href={originalUrl} target="_blank" rel="noopener noreferrer">{ja!.data.title}</a>
						</em>
					</p>
				</div>
			)
		}
	</article>
</Layout>
