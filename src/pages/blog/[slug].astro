---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import T from '../../components/T.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';
import { pageHref } from '../../lib/url';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, tags, github, demo } = post.data;
---

<Layout title={title} description={description}>
	<article class="page">
		<p class="eyebrow">
			<a class="text-link" href={pageHref('/blog')}><Icon name="back" size={16} /> <T en="Research Blog" ja="研究ブログ" /></a
			>
		</p>
		<h1 class="page-title" lang="en">{title}</h1>
		<div class="meta">
			<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
		</div>
		{
			tags.length > 0 && (
				<ul class="tags" style="margin-top:0.75rem">
					{tags.map((tag) => (
						<li class="tag">{tag}</li>
					))}
				</ul>
			)
		}
		{
			(github || demo) && (
				<ul class="post-links">
					{github && (
						<li>
							<a class="text-link" href={github} rel="noopener noreferrer">
								<Icon name="github" size={18} /> <T en="Related GitHub" ja="関連 GitHub" />
							</a>
						</li>
					)}
					{demo && (
						<li>
							<a class="text-link" href={demo} rel="noopener noreferrer">
								<Icon name="play" size={18} /> <T en="Live demo" ja="ライブデモ" />
							</a>
						</li>
					)}
				</ul>
			)
		}

		<div class="prose" style="margin-top:2rem" lang="en">
			<Content />
		</div>
	</article>
</Layout>
