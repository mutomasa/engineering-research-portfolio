---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import T from '../components/T.astro';
import { SITE } from '../consts';
import { pageHref } from '../lib/url';

interface HomeCard {
	icon: IconName;
	title: string;
	titleJa: string;
	text: string;
	textJa: string;
	href?: string;
	external?: boolean;
}

const cards: HomeCard[] = [
	{
		icon: 'code',
		title: 'Projects',
		titleJa: 'プロジェクト',
		text: 'Open-source and research code, synced automatically from GitHub',
		textJa: 'GitHubと自動連携したOSS・研究コード一覧',
		href: '/projects',
	},
	{
		icon: 'server',
		title: 'Home Lab',
		titleJa: 'ホームラボ',
		text: 'An OSS platform for distributed computing, optimization, AI and a lakehouse',
		textJa: 'OSS分散計算・最適化・AI・Lakehouse基盤',
		href: '/lab',
	},
	{
		icon: 'bot',
		title: 'Robots & Equipment',
		titleJa: 'ロボット・機材',
		text: 'Robots, sensors and XR devices I use for research',
		textJa: '研究に使っているロボット・センサー・XR機材',
		href: '/equipment',
	},
	{
		icon: 'pen',
		title: 'Research Blog',
		titleJa: '研究ブログ',
		text: 'Research notes, paper explainers and experiment results',
		textJa: '研究日誌・論文解説・実験結果',
		href: '/blog',
	},
	{
		icon: 'file',
		title: 'Research',
		titleJa: '研究内容',
		text: 'Master’s research at JAIST, research plans and publications',
		textJa: 'JAIST 修士課程での研究テーマ・研究計画・研究成果',
		href: '/research',
	},
	{
		icon: 'slides',
		title: 'Presentations',
		titleJa: '発表資料',
		text: 'Slides and talks published on Speaker Deck',
		textJa: 'Speaker Deckで公開している発表スライド・資料',
		href: '/presentations',
	},
	{
		icon: 'heart',
		title: 'Volunteer',
		titleJa: 'ボランティア',
		text: 'Volunteer technical support for researchers and aspiring entrepreneurs at JAIST',
		textJa: 'JAISTの研究者・起業を志す方への技術支援ボランティア',
		href: '/volunteer',
	},
	{
		icon: 'play',
		title: 'Live Demos',
		titleJa: 'ライブデモ',
		text: 'AI demos running on Hugging Face Spaces',
		textJa: 'Hugging Face Spacesで動くAIデモ',
		href: SITE.huggingface.spacesUrl,
		external: true,
	},
];
---

<Layout>
	<section class="hero" aria-labelledby="hero-title">
		<p class="eyebrow">{SITE.name} — <T en={SITE.title} ja={SITE.titleJa} /></p>
		<h1 class="page-title" id="hero-title">Research &amp; Engineering</h1>
		<p class="lead" style="margin-bottom:0">{SITE.researchThemes.join(' · ')}</p>
	</section>

	<ul class="card-grid">
		{
			cards.map((card) => (
				<li>
					{card.href ? (
						<a
							class="card"
							href={card.external ? card.href : pageHref(card.href)}
							target={card.external ? '_blank' : undefined}
							rel={card.external ? 'noopener noreferrer' : undefined}
						>
							<span class="card-icon">
								<Icon name={card.icon} />
							</span>
							<h2><T en={card.title} ja={card.titleJa} /></h2>
							<p><T en={card.text} ja={card.textJa} /></p>
							<span class="card-cta">
								{card.external ? (
									<>
										<T en="Open Spaces" ja="Spacesを開く" /> <Icon name="external" size={16} />
										<span class="visually-hidden"><T en="(opens in a new tab)" ja="（新しいタブで開きます）" /></span>
									</>
								) : (
									<>
										<T en="View" ja="見る" /> <Icon name="arrow" size={16} />
									</>
								)}
							</span>
						</a>
					) : (
						<div class="card">
							<span class="card-icon">
								<Icon name={card.icon} />
							</span>
							<h2><T en={card.title} ja={card.titleJa} /></h2>
							<p><T en={card.text} ja={card.textJa} /></p>
						</div>
					)}
				</li>
			))
		}
	</ul>
</Layout>
