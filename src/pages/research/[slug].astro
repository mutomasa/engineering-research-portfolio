---
import 'katex/dist/katex.min.css';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import T from '../../components/T.astro';
import PosterImage from '../../components/PosterImage.astro';
import { formatDate } from '../../lib/blog';
import { pageHref } from '../../lib/url';

export async function getStaticPaths() {
	const docs = await getCollection('research');
	return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props as { doc: CollectionEntry<'research'> };
const { Content } = await render(doc);
// 英語版を持つテーマ（本文も日英の両方を持つ）
const en = doc.data.en;
---

<Layout title={en?.title ?? doc.data.title} titleJa={doc.data.title} description={en?.description ?? doc.data.description}>
	<article class="page">
		<p class="eyebrow">
			<a class="text-link" href={pageHref('/research')}><Icon name="back" size={16} /> <T en="Research" ja="研究内容" /></a>
		</p>
		{
			en ? (
				<>
					<h1 class="page-title">
						<T en={en.title} ja={doc.data.title} />
					</h1>
					{doc.data.subtitle && (
						<p class="lead" data-lang-only="ja" lang="en">
							{doc.data.subtitle}
						</p>
					)}
				</>
			) : (
				<>
					<h1 class="page-title" lang="ja">
						{doc.data.title}
					</h1>
					{doc.data.subtitle && <p class="lead" lang="en">{doc.data.subtitle}</p>}
				</>
			)
		}
		<div class="meta">
			{en ? (
				<span class="badge badge-phd">
					<T en={en.kind} ja={doc.data.kind} />
				</span>
			) : (
				<span class="badge" lang="ja">{doc.data.kind}</span>
			)}
			<time datetime={doc.data.updated.toISOString()}>{formatDate(doc.data.updated)}</time>
		</div>
		{
			doc.data.poster && (
				<figure class="poster">
					<PosterImage poster={doc.data.poster} variant="image" width={doc.data.poster.width} linkToFull />
					<figcaption>
						<T en="Research poster (click to enlarge)" ja="研究ポスター（クリックで拡大）" />
						{/* 日本語版・英語版の PDF は、表示中の言語にかかわらず両方載せる */}
						{doc.data.poster.ja.pdf && (
							<a class="text-link" href={doc.data.poster.ja.pdf} target="_blank" rel="noopener">
								<T en="PDF (Japanese)" ja="PDF（日本語版）" />
							</a>
						)}
						{doc.data.poster.en.pdf && (
							<a class="text-link" href={doc.data.poster.en.pdf} target="_blank" rel="noopener">
								<T en="PDF (English)" ja="PDF（英語版）" />
							</a>
						)}
					</figcaption>
				</figure>
			)
		}
		{!en && <p class="lead" data-lang-only="en" lang="en" style="margin-top:1.5rem">This document is available in Japanese only.</p>}
		<div class="prose" style="margin-top:2rem" lang={en ? undefined : 'ja'}>
			<Content />
		</div>
	</article>
</Layout>

<script>
	// ```mermaid のコードブロックを図に変換する（図があるページだけ mermaid を読み込む）
	const blocks = Array.from(document.querySelectorAll<HTMLElement>('pre:has(> code.language-mermaid)'));
	if (blocks.length > 0) {
		const { default: mermaid } = await import('mermaid');
		mermaid.initialize({ startOnLoad: false, theme: 'neutral', securityLevel: 'strict' });
		const nodes = blocks.map((pre) => {
			const div = document.createElement('div');
			div.className = 'mermaid';
			div.textContent = pre.textContent ?? '';
			pre.replaceWith(div);
			return div;
		});
		// 日英の本文を持つページでは、表示中でない言語の図も正しい大きさで描けるよう、
		// 描画の間だけ非表示側を見えない状態のまま配置する
		const hidden = Array.from(document.querySelectorAll<HTMLElement>('.prose [data-lang-only]')).filter(
			(el) => getComputedStyle(el).display === 'none',
		);
		for (const el of hidden) {
			el.style.setProperty('display', 'block', 'important');
			el.style.setProperty('visibility', 'hidden');
			el.style.setProperty('position', 'absolute');
			el.style.setProperty('width', '100%');
		}
		try {
			await mermaid.run({ nodes });
		} finally {
			for (const el of hidden) {
				for (const prop of ['display', 'visibility', 'position', 'width']) el.style.removeProperty(prop);
			}
		}
	}
</script>

<style>
	.poster {
		max-width: 46rem;
		margin: 2rem 0 0;
	}
	.poster :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: #fff;
	}
	.poster figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin-top: 0.5rem;
		color: var(--muted);
		font-size: 0.875rem;
	}
	.prose :global(.mermaid) {
		margin: 0 0 1.5rem;
		overflow-x: auto;
		text-align: center;
	}
	.prose :global(.katex-display) {
		overflow-x: auto;
		overflow-y: hidden;
		padding: 0.25rem 0;
	}
</style>
