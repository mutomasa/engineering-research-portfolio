---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
import { publications } from '../data/publications';

const items = [...publications].sort((a, b) => b.year - a.year);
const kindLabel = {
	paper: { en: 'Paper', ja: '論文' },
	poster: { en: 'Poster', ja: 'ポスター' },
	other: { en: 'Research output', ja: '研究成果' },
} as const;
---

<Layout title="Papers" titleJa="論文" description="Publications, posters and research outputs.">
	<div class="page">
		<h1 class="page-title"><T en="Papers" ja="論文" /></h1>
		<p class="lead">
			<T en="Papers, posters and research outputs." ja="論文・ポスター・研究成果の一覧です。" />
		</p>

		{
			items.length === 0 ? (
				<div class="empty">
					<p style="margin:0">
							<T
								en="There are no papers, posters or research outputs to list yet. They will appear here once available."
								ja="現在、掲載できる論文・ポスター・研究成果はありません。追加され次第ここに掲載します。"
							/>
						</p>
				</div>
			) : (
				<ul class="pub-list">
					{items.map((pub) => (
						<li>
							<article class="card">
								<h2>
									{pub.url ? (
										<a href={pub.url} rel="noopener noreferrer">
											{pub.title}
										</a>
									) : (
										pub.title
									)}
								</h2>
								<p>{pub.authors}</p>
								<div class="meta">
									<span class="badge">
										<T {...kindLabel[pub.kind]} />
									</span>
									<span>{pub.venue}</span>
									<span>{pub.year}</span>
									{pub.url && (
										<span>
											<Icon name="external" size={14} />
											<span class="visually-hidden"><T en="External link" ja="外部リンク" /></span>
										</span>
									)}
								</div>
							</article>
						</li>
					))}
				</ul>
			)
		}
	</div>
</Layout>
