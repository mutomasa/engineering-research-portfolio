---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
import { NAV, SITE } from '../consts';
import { pageHref } from '../lib/url';
import { Image } from 'astro:assets';
import logo from '../../logo/kawasemi_intelligence_log.png';

interface Props {
	title?: string;
	/** 日本語表示時のタイトル（省略時は title を使う） */
	titleJa?: string;
	description?: string;
}

const { title, titleJa, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.title}`;
const pageTitleJa = titleJa
	? `${titleJa} | ${SITE.name}`
	: title
		? pageTitle
		: `${SITE.name} | ${SITE.titleJa}`;

// ビルド後は /projects/ のように末尾スラッシュが付くため正規化して比較する
const normalize = (path: string) => (path.length > 1 ? path.replace(/\/+$/, '') : path);
const current = normalize(Astro.url.pathname);
const isCurrent = (href: string) =>
	href === '/' ? current === '/' : current === href || current.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en" data-title-en={pageTitle} data-title-ja={pageTitleJa}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
		{/* 描画前に表示言語を決めて、言語のちらつきを防ぐ。保存済みの選択 → ブラウザの言語 → 英語 */}
		<script is:inline>
			(() => {
				let lang;
				try {
					lang = localStorage.getItem('lang');
				} catch {}
				if (lang !== 'en' && lang !== 'ja') {
					const browser = (navigator.languages && navigator.languages[0]) || navigator.language || '';
					lang = browser.toLowerCase().startsWith('ja') ? 'ja' : 'en';
				}
				const root = document.documentElement;
				root.dataset.lang = lang;
				root.lang = lang;
				document.title = root.dataset[lang === 'ja' ? 'titleJa' : 'titleEn'] || document.title;
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main"><T en="Skip to content" ja="本文へスキップ" /></a>

		<header class="site-header">
			<div class="container">
				<div class="brand-row">
					<a class="brand" href="/">
						<Image src={logo} alt="" width={44} height={44} densities={[1, 2, 3]} loading="eager" class="brand-logo" />
						<span>{SITE.name}</span>
					</a>
					<div class="lang-switch" role="group" aria-label="Language / 言語">
						<button type="button" data-set-lang="en" lang="en">EN</button>
						<button type="button" data-set-lang="ja" lang="ja">日本語</button>
					</div>
				</div>
				<nav class="site-nav" aria-label="Main">
					<ul>
						{
							NAV.map((item) => (
								<li>
									<a
										href={pageHref(item.href)}
										aria-current={isCurrent(item.href) ? 'page' : undefined}
									>
										<T en={item.label} ja={item.labelJa} />
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<div class="container">
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<div class="container">
				<p style="margin:0">© {new Date().getFullYear()} {SITE.name}</p>
				<ul class="social">
					<li>
						<a href={SITE.github.url} rel="noopener noreferrer">
							<Icon name="github" size={18} /> GitHub
						</a>
					</li>
					<li>
						<a href={SITE.speakerdeck.url} rel="noopener noreferrer">
							<Icon name="slides" size={18} /> Speaker Deck
						</a>
					</li>
					<li>
						<a href={SITE.huggingface.url} rel="noopener noreferrer">
							<Icon name="smile" size={18} /> Hugging Face
						</a>
					</li>
				</ul>
			</div>
		</footer>
	</body>
</html>

<script>
	import { getLang, setLang, type Lang } from '../lib/i18n';

	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-set-lang]'));

	const sync = (lang: Lang) => {
		for (const button of buttons) {
			button.setAttribute('aria-pressed', String(button.dataset.setLang === lang));
		}
		// placeholder などの属性は data-i18n-attr で指定し、data-en / data-ja の値を入れる
		for (const el of document.querySelectorAll<HTMLElement>('[data-i18n-attr]')) {
			const value = el.dataset[lang];
			if (value !== undefined) el.setAttribute(el.dataset.i18nAttr!, value);
		}
	};

	sync(getLang());
	for (const button of buttons) {
		button.addEventListener('click', () => setLang(button.dataset.setLang as Lang));
	}
	document.addEventListener('langchange', (event) => sync((event as CustomEvent<Lang>).detail));
</script>
